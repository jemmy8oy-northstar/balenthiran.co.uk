{
  "openapi": "3.1.1",
  "info": {
    "title": "Balenthiran.WebApi | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/status": {
      "get": {
        "tags": [
          "Balenthiran.WebApi"
        ],
        "operationId": "GetStatus",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
