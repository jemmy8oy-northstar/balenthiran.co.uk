      "post": {
        "tags": [
          "Balenthiran.WebApi"
        ],
        "operationId": "SubscribeToNewsletter",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Subscriber"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Subscriber": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "subscribedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Balenthiran.WebApi"
    }
  ]
